{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('owner').val() === auth.uid && !newData.exists()",
        "owner": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "created": {
          ".write": "auth != null && (data.parent().child('owner').val() === auth.uid || newData.parent().child('owner').val() === auth.uid)",
          ".validate": "newData.isNumber()"
        },
        "state": {
          ".write": "auth != null && (data.parent().child('owner').val() === auth.uid || newData.parent().child('owner').val() === auth.uid)"
        },
        "joined": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "answers": {
          "$qi": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($code).child('state/phase').val() === 'question' && root.child('rooms').child($code).child('state/qk').val() === $qi",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            }
          }
        }
      }
    }
  }
}
